{
  "expo": {
    "name": "Карта дня",
    "slug": "tarot-daily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0723"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findoshka.taro"
    },
    "android": {
      "package": "com.findoshka.taro",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0723"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#D4A24C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b84f1fe8-3532-46f1-8b62-012fde818b92"
      }
    },
    "owner": "findoshka2k26"
  }
}
